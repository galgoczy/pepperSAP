<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  pepperSAP napi mentés időzítése a Mac minin (launchd).

  Másolat ide: ~/Library/LaunchAgents/com.pepperhouse.sap-backup.plist
  A /PATH/TO helyére a valódi útvonalak kerülnek (lásd docs/ADATMENTES.md).

  Ha a gép a megadott időpontban aludt, a launchd ébredés után pótolja a futást.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pepperhouse.sap-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/PATH/TO/pepper-backup.sh</string>
    </array>

    <!-- Minden nap 03:30-kor -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- A script maga is naplóz; ide a nem várt kimenet kerül. -->
    <key>StandardOutPath</key>
    <string>/PATH/TO/PepperBackup/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/PATH/TO/PepperBackup/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
